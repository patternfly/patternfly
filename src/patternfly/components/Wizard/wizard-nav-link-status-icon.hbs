<span class="{{pfv}}wizard__nav-link-status-icon{{#if wizard-nav-link-status-icon--modifier}} {{wizard-nav-link-status-icon--modifier}}{{/if}}"
  {{#if wizard-nav-link-status-icon--attribute}}
    {{{wizard-nav-link-status-icon--attribute}}}
  {{/if}}>
  {{#if wizard-nav-item--IsSuccess}}
    {{feltIcon "rh-ui-check-circle-fill"}}
  {{else if wizard-nav-item--IsWarning}}
    {{feltIcon "rh-ui-warning-fill"}}
  {{else}}
    {{feltIcon "rh-ui-error-fill"}}
  {{/if}}
</span>
