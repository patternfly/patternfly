<span class="{{pfv}}wizard__toggle-status-icon{{#if wizard-toggle-status-icon--modifier}} {{wizard-toggle-status-icon--modifier}}{{/if}}"
  {{#if wizard-toggle-status-icon--attribute}}
    {{{wizard-toggle-status-icon--attribute}}}
  {{/if}}>
  {{#if wizard-toggle-list-item--IsSuccess}}
    {{feltIcon "rh-ui-check-circle-fill"}}
  {{else if wizard-toggle-list-item--IsWarning}}
    {{feltIcon "rh-ui-warning-fill"}}
  {{else}}
    {{feltIcon "rh-ui-error-fill"}}
  {{/if}}
</span>
