{{#if label-icon--value}}
  {{feltIcon label-icon--value}}
{{else}}
  {{#ifEquals label--status "success"}}{{feltIcon "rh-ui-check-circle-fill"}}{{/ifEquals}}
  {{#ifEquals label--status "warning"}}{{feltIcon "rh-ui-warning-fill"}}{{/ifEquals}}
  {{#ifEquals label--status "danger"}}{{feltIcon "rh-ui-error-fill"}}{{/ifEquals}}
  {{#ifEquals label--status "info"}}{{feltIcon "rh-ui-information-fill"}}{{/ifEquals}}
  {{#ifEquals label--status "custom"}}{{feltIcon "rh-ui-notification-fill"}}{{/ifEquals}}
{{/if}}
