<{{#if input-group-text--type}}{{input-group-text--type}}{{else}}span{{/if}} class="{{pfv}}input-group__text{{#if input-group-text--modifier}} {{input-group-text--modifier}}{{/if}}"
  {{#if aria-label}}
    aria-label="{{aria-label}}"
  {{/if}}
  {{#if input-group-text--id}}
    id="{{input-group-text--id}}"
  {{/if}}
  {{#if input-group-text--attribute}}
    {{{input-group-text--attribute}}}
  {{/if}}>
  {{#if input-group-text--value}}
    {{{input-group-text--value}}}
  {{else if @partial-block}}
    {{> @partial-block}}
  {{/if}}
  {{#if input-group-text--HasDollarSignIcon}}
    {{pfIcon "dollar-sign"}}
  {{/if}}
  {{#if input-group-text--HasAtIcon}}
    {{pfIcon "at"}}
  {{/if}}
  {{#if input-group-text--HasCalendarIcon}}
    {{pfIcon "calendar-alt"}}
  {{/if}}
</{{#if input-group-text--type}}{{input-group-text--type}}{{else}}span{{/if}}>