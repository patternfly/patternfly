<div class="{{pfv}}backdrop
  {{setModifiers
    backdrop--IsAnimate='pf-m-animate'
    backdrop--IsShow='pf-m-show'
    backdrop--modifier=backdrop--modifier
  }}"
  {{#if backdrop--attribute}}
    {{{backdrop--attribute}}}
  {{/if}}>
  {{#if @partial-block}}
    {{> @partial-block}}
  {{/if}}
</div>
