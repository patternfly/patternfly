{{#> drawer drawer--id=(concat page-template--id '-drawer') drawer-panel--IsOpen=page-template--drawer-panel--IsOpen drawer--IsViewport=drawer--IsViewport drawer--IsPanelLeft=drawer--IsPanelLeft}}
  {{#> drawer-main}}
    {{#unless page-template--HasNoDrawerContent}}
      {{#> drawer-content}}
        {{> page-template-main-content}}
      {{/drawer-content}}
    {{/unless}}
