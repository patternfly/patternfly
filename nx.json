{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "felt-v1",
  "release": {
    "projects": ["@rh-felt/styles"],
    "projectsRelationship": "fixed",
    "releaseTag": {
      "pattern": "felt-v{version}",
      "strictPreid": true,
      "checkAllBranchesWhen": false
    },
    "version": {
      "specifierSource": "conventional-commits",
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk",
      "manifestRootsToUpdate": ["dist"],
      "versionActionsOptions": {
        "skipLockFileUpdate": true
      }
    },
    "conventionalCommits": {
      "useCommitScope": false,
      "types": {
        "chore": {
          "semverBump": "none"
        },
        "ci": {
          "semverBump": "patch",
          "changelog": false
        }
      }
    },
    "changelog": {
      "automaticFromRef": true,
      "workspaceChangelog": {
        "createRelease": "github",
        "file": false
      },
      "projectChangelogs": false
    }
  },
  "targetDefaults": {
    "nx-release-publish": {
      "cache": false,
      "options": {
        "packageRoot": "dist",
        "access": "public",
        "tag": "prerelease"
      }
    }
  },
  "analytics": false
}
